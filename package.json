{
  "name": "kuzzle-types",
  "version": "1.0.0-beta.1",
  "description": "Shared TypeScript types of the Kuzzle API contract (types only)",
  "author": "The Kuzzle Team <support@kuzzle.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuzzleio/types.git"
  },
  "keywords": [
    "kuzzle",
    "types",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test:types-only",
    "test": "npm run test:lint && npm run test:types && npm run build && npm run test:types-only",
    "test:lint": "eslint . && prettier --check .",
    "test:types": "tsc -p tsconfig.json",
    "test:types-only": "node scripts/check-types-only.mjs"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "eslint-plugin-kuzzle": "2.0.0",
    "kuzzle-sdk": "7.17.1",
    "prettier": "3.9.7",
    "semantic-release-config-kuzzle": "1.3.0",
    "typescript": "5.4.5"
  }
}
